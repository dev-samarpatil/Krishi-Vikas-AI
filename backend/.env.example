# ==============================================================================
# Krishi Vikas AI — Environment Configuration Template
# Server-side configuration only. Never commit real keys or production secrets.
# ==============================================================================

# 🤖 Primary Conversational AI
CHAT_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=30.0
GROQ_MAX_RETRIES=2

# 🌿 Crop Scan & Vision AI (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-flash-lite-latest
GEMINI_CHAT_MODEL=gemini-flash-lite-latest

# 🗣️ Indic Voice Services (Optional)
SARVAM_API_KEY=your_sarvam_api_key_here

# 🗄️ Supabase Persistence & Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 🌦️ Weather & Agriculture
OPENWEATHER_API_KEY=your_openweather_api_key_here

# 🌐 API Links (Production)
NEXT_PUBLIC_BACKEND_URL=https://krishi-vikas-ai.onrender.com
